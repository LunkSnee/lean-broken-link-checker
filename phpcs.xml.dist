<?xml version="1.0"?>
<ruleset name="Lean Broken Link Checker">
	<description>Security sniffs from the WordPress Coding Standards and PHP compatibility for the plugin's minimum PHP version.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>

	<!-- Keep in sync with "Requires PHP" in the plugin header and readme.txt. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
